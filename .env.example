# Copy this file to .env in each service directory and fill in values.
# Never commit actual .env files — this file is safe to commit.

# ─────────────────────────────────────────────────────────────────────────────
# apps/api  (Express backend — port 4000)
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# URL of the Python parser service (no trailing slash)
PARSER_URL=http://localhost:8001

# Comma-separated list of allowed CORS origins
# Production example: https://ledgerlite.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# apps/web  (Next.js frontend — port 3000)
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the Express API — used in next.config.mjs rewrites
# Development : http://localhost:4000
# Staging     : https://api-staging.up.railway.app   (set in Vercel → Preview env)
# Production  : https://api.up.railway.app            (set in Vercel → Production env)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# apps/parser  (FastAPI parser — port 8001)
# ─────────────────────────────────────────────────────────────────────────────

# Railway injects $PORT automatically in deployed environments.
# For local development, override here if 8001 conflicts with something.
PORT=8001
